@page
@model ManoloContactos.Pages.Contactos.IndexModel

@{
    ViewData["Title"] = "Contactos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Contactos</h1>
        <p class="text-muted mb-0">Administra los contactos registrados.</p>
    </div>

    <a asp-page="Create" class="btn btn-primary">
        + Crear nuevo contacto
    </a>
</div>

@if (Model.Contacto.Any())
{
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Cédula</th>
                    <th>Nombre</th>
                    <th>Apellidos</th>
                    <th>Fecha de nacimiento</th>
                    <th>Edad</th>
                    <th>Teléfono</th>
                    <th>Dirección</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.Contacto)
                {
                    <tr>
                        <td>@item.Cedula</td>

                        <td>@item.Nombre</td>

                        <td>@item.Apellidos</td>

                        <td>@item.FechaNacimiento.ToString("dd/MM/yyyy")</td>

                        <td>
                            <span class="badge bg-secondary">
                                @item.Edad años
                            </span>
                        </td>

                        <td>@item.Telefono</td>

                        <td>@item.Direccion</td>

                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-1">
                                <a asp-page="./Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">
                                    Editar
                                </a>

                                <a asp-page="./Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-info btn-sm">
                                    Detalles
                                </a>

                                <a asp-page="./Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger btn-sm">
                                    Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <strong>No hay contactos registrados.</strong>
        Puedes agregar el primero utilizando el botón
        <strong>Crear nuevo contacto</strong>.
    </div>
}